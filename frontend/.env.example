# Base URL of the BusiRAG API (no trailing slash).
VITE_API_BASE_URL=http://127.0.0.1:8000

# Public demo (optional). With both set, the login page shows a
# "Try the demo" button that signs in with this read-only account.
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=

# Hide registration and document upload/delete (match DEMO_MODE on the API).
VITE_DEMO_MODE=false

# Match MAX_QUERY_LENGTH on the API.
VITE_MAX_QUERY_LENGTH=500
