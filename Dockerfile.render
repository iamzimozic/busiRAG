# Lightweight API image for Render's free plan (512 MB RAM): no PyTorch.
# Embeddings run with ONNX Runtime and produce the same vectors as the
# sentence-transformers model used for ingestion.

FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HOME=/app/.cache/huggingface \
    EMBEDDING_BACKEND=onnx \
    RETRIEVAL_MODE=hybrid

WORKDIR /app

COPY requirements.render.txt .

RUN pip install --upgrade pip \
    && pip install -r requirements.render.txt

COPY pyproject.toml .
COPY src/ src/
COPY alembic/ alembic/
COPY alembic.ini .

RUN pip install --no-deps .

# Bake the ONNX embedding model and tokenizer into the image.
RUN python -c "from huggingface_hub import hf_hub_download as d; [d('BAAI/bge-small-en-v1.5', f) for f in ('tokenizer.json', 'onnx/model.onnx')]"

EXPOSE 8000

# Migrations are idempotent; Render provides $PORT.
CMD ["sh", "-c", "alembic upgrade head && uvicorn busirag.api.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
