# Copy to .env and fill in. Never commit .env.

DATABASE_URL=postgresql+psycopg://busirag:busirag@localhost:5432/busirag
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600

# openssl rand -base64 48 / python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me

# Generation provider: gemini (default) | openai | ollama
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:7b

# Retrieval: dense | sparse | hybrid | hybrid_rerank (default)
RETRIEVAL_MODE=hybrid_rerank
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
CANDIDATE_K=50
TOP_K=10

# Public demo protection (0 disables a limit)
MAX_QUERY_LENGTH=500
RATE_LIMIT_PER_MINUTE=0
RATE_LIMIT_PER_DAY=0
DEMO_MODE=false

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
